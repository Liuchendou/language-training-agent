# Language Training Agent - environment sample
#
# 复制成 .env 后按需修改。全部变量都是可选的，每个值都写着内置默认值，
# 因此「留空」与「不设」等价。
#
# ⚠️ 注意：应用本身不读取 .env 文件（代码只用 os.getenv，没有 dotenv 加载）。
#    要让本文件生效，请二选一：
#      a) 用 uvicorn 的 --env-file 参数（python-dotenv 已随 uvicorn[standard] 装好）：
#           .venv\Scripts\python.exe -m uvicorn app.main:app --app-dir backend ^
#               --host 127.0.0.1 --port 8000 --env-file .env
#      b) 直接在启动它的 shell 里 set（Windows cmd / $env: in PowerShell）再启动。
#
#    Windows 路径建议写成正斜杠（E:/Software/LLA-master/LLA-master）或双反斜杠，
#    避免被反斜杠转义。

# --- 路径 -----------------------------------------------------------------
# 仓库根。留空时默认取 backend/app 往上两级，即项目根目录。
LTA_PROJECT_ROOT=
# 以下存储路径留空时统一默认到 <LTA_PROJECT_ROOT>/data/ 下。
LTA_DATABASE_PATH=
LTA_MATERIALS_DIR=
LTA_RECORDINGS_DIR=
LTA_PROCESSED_DIR=

# --- 应用信息 -------------------------------------------------------------
LTA_APP_NAME=Language Training Agent
LTA_ENVIRONMENT=development

# --- 学习时长周窗口 --------------------------------------------------------
# calendar = ISO 自然周（周一起算，默认）；rolling7 = 最近 7 天滚动窗口。
LTA_WEEKLY_WINDOW=calendar

# --- 朗读 Rule Engine 容差 -------------------------------------------------
# PASS 为严格上限，CLOSE 为进入 FAIL 前的宽松上限（Spec 33，阈值待真实样本校准）。
LTA_READING_SPEED_PASS=0.15
LTA_READING_SPEED_CLOSE=0.30
LTA_READING_PAUSE_PASS=2
LTA_READING_PAUSE_CLOSE=4
LTA_READING_STRESS_PASS=0.25
LTA_READING_STRESS_CLOSE=0.45

# --- 周测参数 -------------------------------------------------------------
LTA_WEEKLY_DICTATION_PASS=80
LTA_WEEKLY_TEST_SENTENCES=6
LTA_REINFORCEMENT_MAX_SENTENCES=5

# --- 搜索素材的音质门槛 ----------------------------------------------------
LTA_AUDIO_QUALITY_SAMPLE_RATE=16000
LTA_AUDIO_QUALITY_SNR_DB=15
LTA_AUDIO_QUALITY_SILENCE=0.55
LTA_AUDIO_QUALITY_MIN_DURATION=60

# --- 媒体工具（URL 视频导入）-----------------------------------------------
# 留空时依次查找：PATH -> 项目内 tools/ffmpeg/bin/。
LTA_FFMPEG=
LTA_YTDLP=

# --- 语音识别（faster-whisper）--------------------------------------------
# 未指定本地模型目录时使用的模型规格：tiny / base / small / medium。
LTA_WHISPER_MODEL=base
# 语音语言提示；留空表示自动检测。
LTA_WHISPER_LANGUAGE=
# 已转换好的 faster-whisper 模型目录绝对路径
# （需含 config.json + model.bin + tokenizer.json + vocabulary.txt）。
# 设置后不再尝试下载，并优先于项目内 tools/models/ 的副本。
LTA_WHISPER_MODEL_DIR=

# --- Hugging Face 端点 -----------------------------------------------------
# 公网主机在部分网络下不可达，可在此指定镜像（默认已指向 hf-mirror）。
LTA_HF_ENDPOINT=https://hf-mirror.com

# --- 导入工作目录 ---------------------------------------------------------
# 相对于 LTA_PROCESSED_DIR 的子目录名。
LTA_IMPORT_DIR=imports
